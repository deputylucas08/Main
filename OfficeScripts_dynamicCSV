function main(workbook: ExcelScript.Workbook, AllCSVsArray: { name: string, data: { [key: string]: string }[] }[]) {
  // Loop through each dataset in AllCSVsArray
  AllCSVsArray.forEach(file => {
    let sheetName = file.name.replace(".csv", ""); // Remove ".csv" from filename
    let sheet = workbook.getWorksheet(sheetName) || workbook.addWorksheet(sheetName);

    // Clear only contents (preserve formatting)
    let usedRange = sheet.getUsedRange();
    if (usedRange) {
      usedRange.clear(ExcelScript.ClearApplyTo.contents);
    }

    // Extract headers dynamically
    let headers = Object.keys(file.data[0]);
    let headerRange = sheet.getRange(`A1:${String.fromCharCode(65 + headers.length - 1)}1`);
    headerRange.setValues([headers]);

    // Convert JSON objects to 2D array format
    let formattedData = file.data.map(row => headers.map(header => row[header] || ""));
    
    // Write new data if available
    if (formattedData.length > 0) {
      let dataRange = sheet.getRange(`A2:${String.fromCharCode(65 + headers.length - 1)}${formattedData.length + 1}`);
      dataRange.setValues(formattedData);
    }
  });
}
