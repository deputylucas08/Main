// Interface for data types feeding from All_JSON_Array. This is just a placeholder, you don't need to edit this. It will still work for multiple tabs with different column names etc.
interface JSON_data {
    Site: string;
    SiteURL: string;
    NewWorldBU: string;
}

// Interface for array structure coming from PowerAutomate flow
interface All_JSON_Array {
    name: string;
    data: JSON_data[];
}

// Main 
async function main(workbook: ExcelScript.Workbook,
  AllJSONArray: All_JSON_Array[]){
  /*= [
    {
      name: "Salesdata",
      data: [
        { Site: "2025-03-01", SiteURL: "Laptop", NewWorldBU: "1200"},
        { Site: "2025-03-02", SiteURL: "Tablet", NewWorldBU: "800"},
        { Site: "2025-03-03", SiteURL: "Smartphone", NewWorldBU: "500"},
      ],
    },
    {
      name: "EmployeeRecords",
      data: [
        { Site: "101", SiteURL: "Alice", NewWorldBU: "Engineer"},
        { Site: "102", SiteURL: "Bob", NewWorldBU: "Analyst" },
        { Site: "103", SiteURL: "Charlie", NewWorldBU: "Manager" },
      ],
    },
  ];*/

  for (const myFile of AllJSONArray) {
    let sheetName = myFile.name.substring(0, myFile.name.length - 4).split('_').pop();
    let sheet = workbook.getWorksheet(sheetName) || workbook.addWorksheet(sheetName);

    if (myFile.data.length === 0) continue; // Skip if there's no data

    const columnHeaders = Object.keys(myFile.data[0]);
    const colCount = columnHeaders.length;
    const lastCol= String.fromCharCode(65+ colCount -1);
    sheet.getRange(`A1:${lastCol}1`).setValues([columnHeaders]);

    // Convert data objects to 2D array
    const values = myFile.data.map(row => columnHeaders.map(col => row[col] || ""));

    // Define batch size to stay under 5MB limit (adjustable)
    const batchSize = 10000;

    for (let i = 0; i < values.length; i += batchSize) {
      let batch = values.slice(i, i + batchSize);
      let rowCount = batch.length;

      let rangeStartRow = i + 2;
      let rangeEndRow = rangeStartRow + rowCount - 1;

      let dataRange = sheet.getRange(`A${rangeStartRow}:${lastCol}${rangeEndRow}`);
      dataRange.setValues(batch);

      await workbook.sync(); // Flush the batch to Excel to prevent exceeding 5MB limit
    }
  }
}
