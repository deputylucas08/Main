async function main(workbook: ExcelScript.Workbook) {
  const AllCSVsArray: CSVData[] = [
    {
      Name: "SalesData",
      Data: [
        { Date: "2025-03-01", Product: "Laptop", Sales: "1200", Quantity: "3" },
        { Date: "2025-03-02", Product: "Tablet", Sales: "800", Quantity: "2" },
        { Date: "2025-03-03", Product: "Smartphone", Sales: "500", Quantity: "1" },
      ],
    },
    {
      Name: "EmployeeRecords",
      Data: [
        { ID: "101", Name: "Alice", Role: "Engineer", Salary: "60000" },
        { ID: "102", Name: "Bob", Role: "Analyst", Salary: "50000" },
        { ID: "103", Name: "Charlie", Role: "Manager", Salary: "75000" },
      ],
    },
  ];

  for (const csvFile of AllCSVsArray) {
    let sheet = workbook.getWorksheet(csvFile.Name) || workbook.addWorksheet(csvFile.Name);
    sheet.getRange().clear(); // Clears existing data while preserving formatting

    if (csvFile.Data.length === 0) continue; // Skip if there's no data

    const columnHeaders = Object.keys(csvFile.Data[0]);
    sheet.getRange(`A1:${String.fromCharCode(65 + columnHeaders.length - 1)}1`).setValues([columnHeaders]);

    // Convert data objects to 2D array
    const values = csvFile.Data.map(row => columnHeaders.map(col => row[col] || "")); 

    // Define batch size to stay under 5MB limit (adjustable)
    const batchSize = 5000;

    for (let i = 0; i < values.length; i += batchSize) {
      let batch = values.slice(i, i + batchSize);
      let range = sheet.getRange(`A${i + 2}`).getResizedRange(batch.length, columnHeaders.length);
      range.setValues(batch);

      await workbook.sync(); // Flush the batch to Excel to prevent exceeding 5MB limit
    }
  }
}

// Interface for Power Automate compatibility
interface CSVData {
  Name: string;
  Data: { [key: string]: string }[]; // Dynamic object where keys are column headers
}
