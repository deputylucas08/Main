async function main(workbook: ExcelScript.Workbook, allCSVsArray: CSVData[]) {
  const BATCH_SIZE = 5000; // Adjust batch size as necessary
  const DELAY_SECONDS = 3; // Delay between batches in seconds

  // Function to simulate asynchronous pause
  function sleep(seconds: number): Promise<void> {
    return new Promise(resolve => setTimeout(resolve, seconds * 1000));
  }

  await Excel.run(async (context) => {
    for (const csvFile of allCSVsArray) {
      let sheet = workbook.getWorksheet(csvFile.Name) || workbook.addWorksheet(csvFile.Name);
      sheet.getRange().clear(); // Clears existing data while preserving formatting

      if (csvFile.Data.length === 0) continue; // Skip empty datasets

      // Extract headers dynamically
      const columnHeaders = Object.keys(csvFile.Data[0]);
      const columnCount = columnHeaders.length;

      // Write column headers
      let headerRange = sheet.getRange("A1").getResizedRange(1, columnCount);
      headerRange.values = [columnHeaders];

      // Convert data to 2D array
      const values = csvFile.Data.map(row => columnHeaders.map(col => row[col] || ""));

      // Simulate async batch writing process
      for (let startRow = 0; startRow < values.length; startRow += BATCH_SIZE) {
        let endRow = Math.min(startRow + BATCH_SIZE, values.length);
        let range = sheet.getRange(`A${startRow + 2}`).getResizedRange(endRow - startRow, columnCount);
        range.values = values.slice(startRow, endRow);

        // Flush changes and commit to Excel
        await context.sync();
        await context.flushAsync(); // Ensure the changes are committed
        await context.sync(); // Wait for changes to be committed before proceeding

        // Simulate delay between batches
        await sleep(DELAY_SECONDS); // Add a delay of 3 seconds between batches
      }
    }
  });
}

// Interface for Power Automate compatibility
interface CSVData {
  Name: string;
  Data: { [key: string]: string }[]; // Object keys represent column headers
}
